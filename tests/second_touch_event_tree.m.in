// UIKit-independent event-tree doubles, NOT a BackBoard/device simulator.
#import <Foundation/Foundation.h>
#import <CoreGraphics/CoreGraphics.h>
#include <assert.h>
#include <math.h>
#include <stdio.h>
#include "SBCPUSecondTouchPolicy.h"
@class UIWindow, UIViewController, UIGestureRecognizer;
@interface UIEvent : NSObject @end
@implementation UIEvent @end
@interface UIColor : NSObject
+ (id)clearColor;
@end
@implementation UIColor
+ (id)clearColor { return nil; }
@end
@interface UIView : NSObject
@property CGRect bounds;
@property CGPoint center;
@property CGFloat rotation;
@property BOOL hidden, userInteractionEnabled;
@property CGFloat alpha;
@property id backgroundColor;
@property(weak) UIView *superview;
@property NSMutableArray *subviews, *gestureRecognizers;
- (id)initWithFrame:(CGRect)frame;
- (UIWindow *)window;
- (void)addSubview:(UIView *)v;
- (void)removeFromSuperview;
- (void)addGestureRecognizer:(UIGestureRecognizer *)g;
- (CGPoint)convertPoint:(CGPoint)p toView:(UIView *)v;
- (BOOL)pointInside:(CGPoint)p withEvent:(UIEvent *)e;
- (UIView *)hitTest:(CGPoint)p withEvent:(UIEvent *)e;
@end
@interface UIViewController : NSObject
@property UIView *view;
@property UIViewController *presentedViewController;
@end
@interface UIWindow : UIView
@property(nonatomic) UIViewController *rootViewController;
@end
@interface SBCPUWindow : UIWindow @end
@interface SBCPUTextBackdropLabel : UIView @end
@interface SBCPURootViewController : UIViewController @end
@interface UIGestureRecognizer : NSObject
@property BOOL enabled;
@property(weak) UIView *view;
@property id target;
@property SEL action;
@end
@interface UIPanGestureRecognizer : UIGestureRecognizer
@property NSInteger state;
@property CGPoint translation;
- (id)initWithTarget:(id)t action:(SEL)a;
- (CGPoint)translationInView:(UIView *)v;
- (void)setTranslation:(CGPoint)p inView:(UIView *)v;
@end
static const NSInteger UIGestureRecognizerStateBegan=1, UIGestureRecognizerStateChanged=2;
@implementation UIView
- (id)init { return [self initWithFrame:CGRectZero]; }
- (id)initWithFrame:(CGRect)f { if ((self=[super init])) { _bounds=(CGRect){CGPointZero,f.size}; _center=CGPointMake(CGRectGetMidX(f),CGRectGetMidY(f)); _alpha=1; _userInteractionEnabled=YES; _subviews=[NSMutableArray array]; _gestureRecognizers=[NSMutableArray array]; } return self; }
- (UIWindow *)window { if ([self isKindOfClass:UIWindow.class]) return (id)self; return self.superview.window; }
- (void)addSubview:(UIView *)v { [v removeFromSuperview]; v.superview=self; [self.subviews addObject:v]; }
- (void)removeFromSuperview { [self.superview.subviews removeObject:self]; self.superview=nil; }
- (void)addGestureRecognizer:(UIGestureRecognizer *)g { g.view=self; [self.gestureRecognizers addObject:g]; }
- (CGPoint)toParent:(CGPoint)p { CGFloat x=p.x-self.bounds.size.width/2,y=p.y-self.bounds.size.height/2; return CGPointMake(self.center.x+x*cos(self.rotation)-y*sin(self.rotation),self.center.y+x*sin(self.rotation)+y*cos(self.rotation)); }
- (CGPoint)fromParent:(CGPoint)p { CGFloat x=p.x-self.center.x,y=p.y-self.center.y; return CGPointMake(x*cos(self.rotation)+y*sin(self.rotation)+self.bounds.size.width/2,-x*sin(self.rotation)+y*cos(self.rotation)+self.bounds.size.height/2); }
- (CGPoint)toWorld:(CGPoint)p { if (!self.superview) return p; return [self.superview toWorld:[self toParent:p]]; }
- (CGPoint)fromWorld:(CGPoint)p { if (!self.superview) return p; return [self fromParent:[self.superview fromWorld:p]]; }
- (CGPoint)convertPoint:(CGPoint)p toView:(UIView *)v { return [v fromWorld:[self toWorld:p]]; }
- (BOOL)pointInside:(CGPoint)p withEvent:(UIEvent *)e { (void)e; return CGRectContainsPoint(self.bounds,p); }
- (UIView *)hitTest:(CGPoint)p withEvent:(UIEvent *)e {
    if (self.hidden || !self.userInteractionEnabled || self.alpha<=0.01 || ![self pointInside:p withEvent:e]) return nil;
    for (UIView *v in self.subviews.reverseObjectEnumerator) { UIView *h=[v hitTest:[self convertPoint:p toView:v] withEvent:e]; if(h) return h; }
    // Mirrors production SBCPUPassthroughView's empty-root rejection.
    return [self isKindOfClass:SBCPUTextBackdropLabel.class] ? self : nil;
}
@end
@implementation UIViewController
- (id)init { if ((self=[super init])) _view=[[UIView alloc] initWithFrame:CGRectMake(0,0,400,800)]; return self; }
@end
@implementation UIWindow
- (void)setRootViewController:(UIViewController *)r { _rootViewController=r; [self addSubview:r.view]; }
@end
@implementation SBCPUTextBackdropLabel @end
@implementation UIGestureRecognizer @end
@implementation UIPanGestureRecognizer
- (id)initWithTarget:(id)t action:(SEL)a { if ((self=[super init])) { self.target=t; self.action=a; self.enabled=YES; } return self; }
- (CGPoint)translationInView:(UIView *)v { assert(v==self.view.superview); return self.translation; }
- (void)setTranslation:(CGPoint)p inView:(UIView *)v { assert(v==self.view.superview); self.translation=p; }
@end
static SBCPUWindow *cpuWindow;
static SBCPUTextBackdropLabel *textOnly2Label;
static UIView *floatingView;
static BOOL textOnly2Locked, floatingTextOnlyMode2=YES, isEnabled=YES, settingsShowing, detailShowing;
static BOOL textOnly2Dragging=NO;
typedef int SBCPUTextGeometry;
static SBCPUTextGeometry textOnlySecondGeometry(void) { return 0; }
static BOOL SBCPUTextHUDShouldExist(BOOL e,BOOL m,BOOL w,BOOL r) { return e&&m&&w&&r; }
static void clearTextSlots(id label) { (void)label; }
/*SYNC*/
@implementation SBCPURootViewController
/*PAN*/
@end
/*UPDATE*/
/*WINDOW*/
static void deliver(CGPoint point, NSInteger state, CGPoint delta) {
    UIView *hit=[cpuWindow hitTest:point withEvent:nil];
    for (UIPanGestureRecognizer *g in hit.gestureRecognizers) if (hit.userInteractionEnabled && g.enabled) {
        g.state=state; g.translation=delta;
        void (*send)(id,SEL,id)=(void (*)(id,SEL,id))[g.target methodForSelector:g.action];
        send(g.target,g.action,g);
    }
}
int main(void) { @autoreleasepool {
    cpuWindow=[[SBCPUWindow alloc] initWithFrame:CGRectMake(0,0,400,800)];
    cpuWindow.rootViewController=[SBCPURootViewController new];
    floatingView=[[UIView alloc] initWithFrame:CGRectMake(10,600,80,40)];
    [cpuWindow.rootViewController.view addSubview:floatingView];
    updateTextOnlySecond();
    textOnly2Label.bounds=CGRectMake(0,0,60,20); textOnly2Label.center=CGPointMake(180,200);
    assert(textOnly2Label.window==cpuWindow);
    UIPanGestureRecognizer *original=textOnly2Label.gestureRecognizers.firstObject;
    assert(original.target==cpuWindow.rootViewController && original.view==textOnly2Label);
    for (int round=0;round<3;round++) {
        CGPoint p=textOnly2Label.center;
        textOnly2Locked=YES; updateTextOnlySecond();
        assert(!original.enabled && !textOnly2Label.userInteractionEnabled && !textOnly2Dragging);
        assert([cpuWindow hitTest:p withEvent:nil]==nil);
        assert([cpuWindow hitTest:CGPointMake(20,610) withEvent:nil]==floatingView);
        assert([cpuWindow hitTest:CGPointMake(300,500) withEvent:nil]==nil);
        deliver(p,UIGestureRecognizerStateBegan,CGPointZero);
        assert(!textOnly2Dragging);
        textOnly2Locked=NO; updateTextOnlySecond();
        assert(original==textOnly2Label.gestureRecognizers.firstObject && original.enabled);
        assert([cpuWindow hitTest:p withEvent:nil]==textOnly2Label);
        deliver(p,UIGestureRecognizerStateBegan,CGPointZero);
        deliver(p,UIGestureRecognizerStateChanged,CGPointMake(12,7));
        assert(textOnly2Dragging && textOnly2Label.center.x==p.x+12 && textOnly2Label.center.y==p.y+7);
        textOnly2Label.rotation=M_PI_2;
        assert([cpuWindow hitTest:CGPointMake(textOnly2Label.center.x,textOnly2Label.center.y+25) withEvent:nil]==textOnly2Label);
        assert([cpuWindow hitTest:CGPointMake(textOnly2Label.center.x+25,textOnly2Label.center.y) withEvent:nil]==nil);
        textOnly2Label.rotation=0;
    }
    // Stale flags must NOT withdraw a separate window: super still traverses host.
    settingsShowing=YES; assert([cpuWindow hitTest:textOnly2Label.center withEvent:nil]==textOnly2Label);
    textOnly2Locked=YES; updateTextOnlySecond(); assert([cpuWindow hitTest:textOnly2Label.center withEvent:nil]==nil);
    settingsShowing=NO; detailShowing=YES; textOnly2Locked=NO; updateTextOnlySecond();
    assert([cpuWindow hitTest:textOnly2Label.center withEvent:nil]==textOnly2Label); detailShowing=NO;
    textOnly2Label.hidden=YES; assert([cpuWindow hitTest:textOnly2Label.center withEvent:nil]==nil); textOnly2Label.hidden=NO;
    floatingTextOnlyMode2=NO; updateTextOnlySecond(); assert(textOnly2Label==nil && !textOnly2Dragging);
    floatingTextOnlyMode2=YES; updateTextOnlySecond(); assert(textOnly2Label.window==cpuWindow && textOnly2Label.userInteractionEnabled);
    puts("PASS production host construction -> hit conversion -> recognizer -> pan -> lock/unlock/recreate (event-tree doubles; NOT device testing)");
} return 0; }
